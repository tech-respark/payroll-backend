<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8"/>
    <title>Payslip for $!monthTitle</title>
    <style>
        @page { size: A4; margin: 16mm; }
        body {
            font-family: Arial, Helvetica, sans-serif;
            color: #17243A;
            font-size: 12px;
            margin: 0;
        }
        .paper { width: 100%; }
        .letterhead { border-bottom: 2px solid #10264D; padding-bottom: 10px; }
        .company { font-size: 18px; font-weight: bold; color: #10264D; margin: 0; }
        .address { font-size: 11px; color: #71829D; margin: 4px 0 0 0; }
        .logo { width: 48px; height: 48px; }
        .title { font-size: 14px; font-weight: bold; margin: 14px 0 0 0; }
        .period { font-size: 11px; color: #71829D; margin: 4px 0 14px 0; }
        .section { font-size: 11px; font-weight: bold; color: #71829D; margin: 0 0 6px 0; }
        table.meta, table.lines { width: 100%; border-collapse: collapse; }
        table.meta { margin-bottom: 14px; }
        table.meta td { width: 50%; vertical-align: top; padding: 0 12px 0 0; }
        table.kv { width: 100%; border-collapse: collapse; }
        table.kv td { padding: 4px 0; border-bottom: 1px solid #DCE5EF; font-size: 12px; }
        table.kv .label { color: #71829D; }
        table.kv .value { text-align: right; font-weight: bold; }
        table.lines { margin-bottom: 14px; }
        table.lines th, table.lines td { border: 1px solid #DCE5EF; padding: 6px 8px; }
        table.lines th { background: #F6F9FC; text-align: left; font-size: 11px; color: #71829D; }
        .amount { text-align: right; white-space: nowrap; }
        .totals td { font-weight: bold; background: #F6F9FC; }
        .net { border: 1px solid #10264D; padding: 10px 12px; margin-bottom: 16px; }
        .net-label { font-size: 11px; color: #71829D; font-weight: bold; margin: 0; }
        .net-amount { font-size: 18px; font-weight: bold; color: #10264D; margin: 0; text-align: right; white-space: nowrap; }
        .words { font-size: 12px; margin: 4px 0 0 0; }
        .footer { text-align: center; font-size: 10px; color: #71829D; }
    </style>
</head>
<body>
<div class="paper">
    <div class="letterhead">
        <table style="width:100%; border-collapse:collapse;">
            <tr>
                #if($logo && $logo != "")
                <td style="width:56px; vertical-align:middle;"><img class="logo" src="$logo" alt=""/></td>
                #end
                <td style="vertical-align:middle;">
                    <p class="company">$!companyName</p>
                    #if($address && $address != "")
                    <p class="address">$!address</p>
                    #end
                </td>
            </tr>
        </table>
    </div>

    <p class="title">Payslip for $!monthTitle</p>
    <p class="period">$!periodLabel</p>

    <table class="meta">
        <tr>
            <td>
                <p class="section">Employee</p>
                <table class="kv">
                    <tr><td class="label">Name</td><td class="value">$!personnelName</td></tr>
                    <tr><td class="label">Employee code</td><td class="value">$!employeeCode</td></tr>
                    <tr><td class="label">Designation</td><td class="value">$!designation</td></tr>
                    <tr><td class="label">Location</td><td class="value">$!storeName</td></tr>
                    #if($hasBank)
                    <tr><td class="label">Bank</td><td class="value">$!bankName</td></tr>
                    #end
                    #if($maskedAccount && $maskedAccount != "")
                    <tr><td class="label">Account</td><td class="value">$!maskedAccount</td></tr>
                    #end
                    #if($hasIfsc)
                    <tr><td class="label">IFSC</td><td class="value">$!IfscCode</td></tr>
                    #end
                    #if($hasPan)
                    <tr><td class="label">PAN</td><td class="value">$!panNo</td></tr>
                    #end
                    #if($hasUan)
                    <tr><td class="label">UAN</td><td class="value">$!uanNumber</td></tr>
                    #end
                </table>
            </td>
            <td>
                <p class="section">Attendance</p>
                <table class="kv">
                    <tr><td class="label">Calendar days</td><td class="value">$!totalDays</td></tr>
                    <tr><td class="label">Working days</td><td class="value">$!totalWorkingDays</td></tr>
                    <tr><td class="label">Weekly offs</td><td class="value">$!totalweeklyOff</td></tr>
                    <tr><td class="label">Holidays</td><td class="value">$!totalHolidays</td></tr>
                    <tr><td class="label">Paid leave</td><td class="value">$!totalPaidLeaves</td></tr>
                    <tr><td class="label">Absent</td><td class="value">$!absentDays</td></tr>
                    <tr><td class="label">Penalty days</td><td class="value">$!penaltyAbsentDays</td></tr>
                    <tr><td class="label">Paid days</td><td class="value">$!totalPaidDays</td></tr>
                </table>
            </td>
        </tr>
    </table>

    <table class="lines">
        <thead>
            <tr>
                <th>Earnings</th>
                <th class="amount">Amount</th>
                <th>Deductions</th>
                <th class="amount">Amount</th>
            </tr>
        </thead>
        <tbody>
            #if($maxRows > 0)
                #foreach($i in [0..$loopEnd])
                <tr>
                    #if($i < $earningSize)
                    <td>$!earningNames.get($i)</td>
                    <td class="amount">₹$!earningAmounts.get($i)</td>
                    #else
                    <td></td><td class="amount"></td>
                    #end
                    #if($i < $deductionSize)
                    <td>$!deductionNames.get($i)</td>
                    <td class="amount">₹$!deductionAmounts.get($i)</td>
                    #else
                    <td></td><td class="amount"></td>
                    #end
                </tr>
                #end
            #else
                <tr><td></td><td class="amount"></td><td></td><td class="amount"></td></tr>
            #end
            <tr class="totals">
                <td>Gross earnings</td>
                <td class="amount">₹$!totalEarning</td>
                <td>Total deductions</td>
                <td class="amount">₹$!totalDeduction</td>
            </tr>
        </tbody>
    </table>

    <div class="net">
        <table style="width:100%; border-collapse:collapse;">
            <tr>
                <td style="vertical-align:middle;">
                    <p class="net-label">Net payable</p>
                    <p class="words">$!salaryAmountInWords</p>
                </td>
                <td class="net-amount" style="vertical-align:middle;">₹$!salaryAmount</td>
            </tr>
        </table>
    </div>

    <p class="footer">This is a computer-generated payslip and does not require a signature.</p>
</div>
</body>
</html>
